ENVIRONMENT=development
# Default to the dockerised Postgres host (`db`). Override locally if needed.
DATABASE_URL=postgresql+asyncpg://mindwell:mindwell@db:5432/mindwell
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
COMPANION_MESSAGE_RATE_PER_MINUTE=60
COMPANION_SESSION_RATE_PER_MINUTE=20
LOG_LEVEL=INFO
MONGO_ENABLED=false
MONGO_URL=mongodb://mongo:27017
MONGO_DATABASE=mindwell
MONGO_MESSAGE_COLLECTION=companion_messages
MONGO_SESSION_CONTEXT_COLLECTION=companion_session_contexts
COMPANION_OUTBOX_POLL_INTERVAL_SECONDS=5
COMPANION_OUTBOX_BATCH_SIZE=50

# Supabase (set your own project credentials)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

DISABLE_RATE_LIMITING=false
LLM_PROVIDER=ollama
OLLAMA_ENDPOINT=http://ollama:11434/api/generate
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT=120.0
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-1.5-flash-001
VERTEX_API_ENDPOINT=
